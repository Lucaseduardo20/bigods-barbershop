# Proxy reverso + TLS automático (Let's Encrypt) pra API — só isso roda na
# EC2 atrás de domínio público. Os 3 frontends são S3+CloudFront, à parte.
#
# Variáveis vêm do .env (docker-compose.aws.yml injeta via env_file):
#   API_DOMAIN=api.suabarbearia.com
#   ACME_EMAIL=voce@suabarbearia.com   (aviso de expiração de certificado, exigido pela Let's Encrypt)
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	reverse_proxy api:3000 {
		# SOBRESCREVE (não acrescenta) o X-Forwarded-For com o IP real do peer.
		# O default do Caddy é acrescentar, o que deixaria um cliente mandar o
		# próprio X-Forwarded-For e ganhar um balde de rate limit novo a cada
		# requisição — furando o limite por origem do envio de OTP. A API roda
		# com `trust proxy = 1` e confia neste cabeçalho; ele precisa ser nosso.
		header_up X-Forwarded-For {remote_host}
	}

	# Access log básico — útil pra depurar sem entrar no container da API.
	log {
		output stdout
		format console
	}
}
