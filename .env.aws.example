# Template de .env para a EC2 de produção REAL na AWS (docker-compose.aws.yml).
# Diferente do .env.docker.example (staging autocontido): aqui NÃO existe
# Postgres nem frontends em container — o banco é RDS (endpoint externo) e os
# frontends são S3+CloudFront (deploy separado, ver .env.frontends.example e
# scripts/deploy-frontends.sh).
#
# Uso na EC2 (ver AWS_SETUP.md pro passo a passo completo):
#   cp .env.aws.example .env
#   # preenche os valores NÃO-secretos abaixo (domínio, região etc)
#   scripts/fetch-secrets-ssm.sh   # busca os segredos (AUTH_SECRET, DATABASE_URL etc) do SSM Parameter Store
#   docker compose -f docker-compose.aws.yml up -d --build

NODE_ENV="production"

# ─────────────────────────────────────────────────────────────────────────────
# Segredos — NÃO preencha aqui. scripts/fetch-secrets-ssm.sh busca do SSM
# Parameter Store e escreve nestas chaves automaticamente. Deixe em branco.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=""
AUTH_SECRET=""
WHATSAPP_OTP_INTERNAL_TOKEN=""
ABACATEPAY_API_KEY="abc_dev_PMpufFuFYSwhGwLBxBwbn4FQ"
ABACATEPAY_WEBHOOK_SECRET="a1186b7081f31f864439f2920ec47bfbc1ad5c0dfdd6a8b4f62d8838a7522ff4"

# ── Comissao sobre o LIQUIDO (Fase 8) ───────────────────────────────────────
# Taxa efetiva do gateway em PONTOS-BASE: inteiro, 1% = 100, 2,99% = 299.
# ABACATEPAY: OBRIGATORIA (ela nao informa liquido em resposta nenhuma).
# MERCADOPAGO: obrigatoria so em producao (o liquido vem em `paid_amount`).
# Use 0 para a casa bancar a taxa — mas escreva 0, nao deixe vazio.
ABACATEPAY_TAXA_BASIS_POINTS=""
MERCADOPAGO_TAXA_BASIS_POINTS=""
# Mercado Pago — vêm do SSM (scripts/fetch-secrets-ssm.sh), nunca preenchidos aqui.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
MERCADOPAGO_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Identidade do CLIENTE final. Dois canais reais, os dois aceitos em produção:
#
#   whatsapp  → Baileys, celular pareado (serviço whatsapp-otp deste compose).
#               Exige WHATSAPP_OTP_INTERNAL_TOKEN.
#   cognito   → SMS, via Cognito Custom Auth + as 3 Lambdas de
#               infra/cognito-triggers. Exige COGNITO_USER_POOL_ID,
#               COGNITO_CLIENT_ID e AWS_REGION abaixo.
#
# ⚠ As credenciais do SMS (SMS_GATE_USER / SMS_GATE_PASSWORD) NÃO entram aqui:
# são variáveis de ambiente da Lambda create-auth-challenge. A API nunca as vê
# — ver infra/cognito-triggers/README.md.
#
# Qualquer outro valor é recusado no boot (não envia OTP real).
# ─────────────────────────────────────────────────────────────────────────────
IDENTITY_PROVIDER="whatsapp"
DEMO_MODE="false"

# Dentro do docker-compose.aws.yml, o serviço de WhatsApp é "whatsapp-otp"
# (mesma rede Docker da API, nunca exposto publicamente — ver AWS_SETUP.md §5).
# Só com IDENTITY_PROVIDER=cognito (deixe vazio no modo whatsapp). Sem as três,
# a API não inicializa — identity.module.ts as exige explicitamente.
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
AWS_REGION="sa-east-1"
# Validade do código; o padrão do Cognito é curto. Opcional.
COGNITO_OTP_TTL_MINUTOS="5"

WHATSAPP_OTP_SERVICE_URL="http://whatsapp-otp:3100"
WHATSAPP_OTP_TIMEOUT_MS="8000"
WHATSAPP_OTP_TTL_MINUTOS="5"

# ─────────────────────────────────────────────────────────────────────────────
# Pagamento — presencial-only até decidir ligar o PIX online (troca desta
# variável + preencher ABACATEPAY_* no SSM, sem mudar código).
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY="abacatepay"
ABACATEPAY_BASE_URL="https://api.abacatepay.com/v2"
ABACATEPAY_EXPIRA_SEGUNDOS="3600"

# Mercado Pago (PAYMENT_GATEWAY="mercadopago"). Só a configuração NÃO-secreta
# fica aqui; token, chave pública e webhook secret vêm do SSM. Uma aplicação por
# ambiente — a URL de webhook é por aplicação, não vai no corpo da order.
MERCADOPAGO_ENV="producao"
MERCADOPAGO_APPLICATION_ID=""
MERCADOPAGO_USER_ID=""
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_BASE_URL="https://api.mercadopago.com"
MERCADOPAGO_EXPIRA_SEGUNDOS="1800"
REEMBOLSO_PRAZO_DIAS="31"

# WhatsApp da barbearia em E.164 SEM o "+" (ex.: 5511990036469). Servido pela API
# em /public/empresa e usado pelas telas que oferecem "falar com a barbearia" —
# hoje o card de reembolso em analise, na conta do cliente.
# Vazio ou com menos de 12 digitos = o botao simplesmente NAO aparece (link
# quebrado e pior que link nenhum).
# Se estiver vazio, cai em PAGAMENTO_MANUAL_WHATSAPP_NUMERO, que e o mesmo
# telefone — preencher os dois com o mesmo valor seria uma armadilha.
BARBEARIA_WHATSAPP=""

# Quantas cobrancas de CARTAO uma mesma origem (IP) pode disparar por 10 minutos.
# E o unico limite entre um `intencaoId` vazado e uma bateria de tentativas
# contra a nossa conta no gateway — NUNCA desligue. Valor <= 0 e ignorado e cai
# no padrao (10), para que um .env mal preenchido nao abra a porta.
# Suba se cliente legitimo levar 429: operadoras moveis usam CGNAT e muitos
# clientes reais podem sair pelo mesmo IP publico.
CARTAO_LIMITE_POR_ORIGEM="10"

# ─────────────────────────────────────────────────────────────────────────────
# Pagamento manual por WhatsApp — TEMPORÁRIO (2026-08-18), enquanto a
# AbacatePay não libera produção. Com a flag "true", o "pagar online" do funil
# não gera PIX: manda o cliente pro WhatsApp com a comanda pronta, e o dono
# confirma no admin quando o PIX cair por fora. Desligar = "false" (ou apagar
# as duas linhas); o gateway volta ao normal sem mexer em código.
#
# ⚠ Com a flag "true", a API RECUSA SUBIR se o número tiver menos de 12
# dígitos — é E.164 SÓ COM DÍGITOS, começando pelo DDI (55 + DDD + número).
# Falha fechada no boot em vez de mandar o cliente pra um link quebrado na
# hora de pagar. Este é o número que RECEBE os pedidos: tem que ser um
# aparelho que alguém olha.
# ─────────────────────────────────────────────────────────────────────────────
PAGAMENTO_MANUAL_WHATSAPP="false"
PAGAMENTO_MANUAL_WHATSAPP_NUMERO=""

# ─────────────────────────────────────────────────────────────────────────────
# Upload de imagens (foto de barbeiro e de produto, 2026-08-19) — bucket S3
# SEPARADO dos três buckets de frontend, que o deploy apaga a cada publicação
# (`aws s3 sync --delete`). Público para LEITURA; escrita só pela IAM Role da
# EC2, que precisa de s3:PutObject e s3:DeleteObject neste bucket.
#
# Sem estas duas variáveis o upload responde "não está configurado" com
# mensagem clara e o resto do sistema segue normal — foto é opcional em todo
# lugar (quem não tem cai nas iniciais/placeholder).
# ─────────────────────────────────────────────────────────────────────────────
UPLOADS_BUCKET=""
UPLOADS_REGION="sa-east-1"
# Vazio = URL virtual-hosted do S3 (https://<bucket>.s3.<região>.amazonaws.com).
# Preencher só no dia em que um CloudFront/domínio próprio entrar na frente do
# bucket — as URLs já gravadas continuam respondendo pelo endereço antigo.
UPLOADS_BASE_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Caddy (proxy reverso + TLS automático) — ver Caddyfile na raiz.
# ─────────────────────────────────────────────────────────────────────────────
# Domínio público da API (DNS já apontado pro IP da EC2 antes de subir, senão
# a emissão do certificado Let's Encrypt falha).
API_DOMAIN="api.suabarbearia.com"
# E-mail de aviso de expiração de certificado (exigido pela Let's Encrypt).
ACME_EMAIL="voce@suabarbearia.com"

# --- CONTINGENCIA DE OTP (2026-09-04) — TEMPORARIA, reversivel -------------
# O SMS de verificacao parou de chegar de forma confiavel: a rota do provedor
# atual nao e uma rota A2P propria pra OTP, e as mensagens somem no caminho sem
# erro nenhum do nosso lado. Com isso o cliente nao consegue agendar nem entrar
# na conta.
#
# Com OTP_CONTINGENCIA="true":
#   - o funil aceita agendar SEM verificar o telefone;
#   - o agendamento nasce AGUARDANDO_APROVACAO e alguem da casa aprova no
#     painel (o filtro anti-poluicao vira uma pessoa, no lugar do codigo);
#   - cota de presenciais, janela de agendamento e conflito de horario
#     continuam valendo exatamente como antes.
#
# Com "false" (ou ausente, que e o default) o sistema volta 100% ao fluxo com
# OTP, sem nenhuma pendencia extra. NADA do codigo de OTP foi removido — isto e
# um desvio, e desligar a variavel desfaz o desvio.
#
# A causa raiz (contratar uma rota A2P propria pra OTP) esta em
# DECISOES_PENDENTES. Quando resolvida, apague esta variavel.
OTP_CONTINGENCIA="false"
