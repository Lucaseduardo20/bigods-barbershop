DATABASE_URL="postgresql://bigods:bigods@localhost:5432/bigods"
AUTH_SECRET="dev-secret-change-me"

# ─────────────────────────────────────────────────────────────────────────────
# Identidade do CLIENTE final (login OTP por telefone)
# ─────────────────────────────────────────────────────────────────────────────
# Provider ativo: "demo" (padrão em dev, sem envio real) ou "whatsapp" (produção,
# via WhatsApp (Baileys) — ver services/whatsapp-otp/). Trocar entre os dois é SÓ esta
# variável — nenhum código de aplicação muda. A aplicação RECUSA subir em
# produção (NODE_ENV=production) com qualquer valor que não seja "whatsapp".
#
# (O Cognito saiu do fluxo nesta sessão — substituído pelo WhatsApp para o
# lançamento presencial-only. O código ainda existe em
# apps/api/src/modules/identity/infrastructure/cognito-identity.provider.ts,
# só não é mais uma opção aqui; ver DECISOES_PENDENTES.md.)
IDENTITY_PROVIDER="demo"

# DEMO_MODE=true faz a API devolver o código OTP na própria resposta (sem
# envio real), para testar sem depender de nada externo. NUNCA use em
# produção: a aplicação RECUSA subir se DEMO_MODE=true e NODE_ENV=production
# ao mesmo tempo.
DEMO_MODE="true"

# Minutos de validade do código OTP no provider demo.
DEMO_OTP_TTL_MINUTOS="5"

# Quantos códigos uma MESMA origem (IP) pode disparar por HORA, somando todos os
# telefones. Existe porque o envio de OTP não depende de conta prévia: qualquer
# telefone recebe WhatsApp de verdade, então sem este teto o sistema serviria de
# vetor de spam e o número da barbearia queimaria por volume (risco de ban da
# Meta). O limite por telefone (5/10min) NÃO cobre isso — quem varre mil números
# ganha mil baldes.
#
# Default 30: um cliente real manda 1–2 por agendamento. Se clientes legítimos
# começarem a levar 429, suba — operadoras móveis usam CGNAT e muita gente sai
# pelo mesmo IP público. Nunca desligue.
OTP_LIMITE_POR_ORIGEM_HORA="30"

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp OTP (Baileys) — PREENCHER para produção (IDENTITY_PROVIDER=whatsapp)
# O código chega por WhatsApp via um serviço Node SEPARADO (processo próprio,
# sessão instável isolada da API) — ver services/whatsapp-otp/README.md para
# como instalar, conectar o número (QR) e operar em produção (pm2/systemd).
# ⚠️ Use um número DESCARTÁVEL, nunca o número oficial da barbearia — risco de
# ban por automação não-oficial do WhatsApp (decisão do dono).
# ─────────────────────────────────────────────────────────────────────────────
# URL onde o services/whatsapp-otp está rodando (ex.: http://localhost:3100
# em dev, ou o endereço interno do processo em produção).
WHATSAPP_OTP_SERVICE_URL=""
# Token compartilhado com services/whatsapp-otp (MESMO valor dos dois lados) —
# protege o endpoint /enviar de qualquer coisa na rede interna. Gere com, por
# exemplo, `openssl rand -hex 32`.
WHATSAPP_OTP_INTERNAL_TOKEN=""
# Timeout (ms) da chamada ao serviço de WhatsApp antes de desistir e devolver
# erro limpo ao cliente (nunca trava o request de login). Default 8000.
WHATSAPP_OTP_TIMEOUT_MS="8000"
# Minutos de validade do código OTP enviado por WhatsApp. Default 5.
WHATSAPP_OTP_TTL_MINUTOS="5"

# ─────────────────────────────────────────────────────────────────────────────
# Pagamento (PIX via AbacatePay)
# ─────────────────────────────────────────────────────────────────────────────
# Adapter ativo: "abacatepay" (real) ou "fake" (dev/test, sem gateway externo).
# Default: abacatepay em producao, fake fora dela. Trocar e SO esta variavel —
# nenhum codigo de dominio/aplicacao muda. O fake NAO expoe webhook nenhum.
PAYMENT_GATEWAY="abacatepay"

# API key da AbacatePay (painel > Integrar > API Keys). Sandbox e producao usam
# a MESMA base; a diferenca e so a key. OBRIGATORIA com PAYMENT_GATEWAY=abacatepay.
ABACATEPAY_API_KEY="abc_dev_PMpufFuFYSwhGwLBxBwbn4FQ"

# Segredo do webhook (painel > Webhooks, ao criar o endpoint). Usado para validar
# a assinatura HMAC-SHA256 de cada webhook. OBRIGATORIO com o gateway real — a
# aplicacao RECUSA subir sem ele quando PAYMENT_GATEWAY=abacatepay.
ABACATEPAY_WEBHOOK_SECRET="a1186b7081f31f864439f2920ec47bfbc1ad5c0dfdd6a8b4f62d8838a7522ff4"

# Base da API — Checkout Transparente v2 (/transparents/*). So mude se a
# AbacatePay publicar outra versao/base (DECISOES_PENDENTES.md #10).
ABACATEPAY_BASE_URL="https://api.abacatepay.com/v2"

# Validade da cobranca PIX em segundos (default 3600).
ABACATEPAY_EXPIRA_SEGUNDOS="3600"
