DATABASE_URL="postgresql://bigods:bigods@localhost:5432/bigods"
AUTH_SECRET="dev-secret-change-me"

# ─────────────────────────────────────────────────────────────────────────────
# Identidade do CLIENTE final (login OTP por telefone)
# ─────────────────────────────────────────────────────────────────────────────
# Provider ativo: "demo" (padrão em dev, 100% sem AWS) ou "cognito" (produção).
# Trocar entre os dois é SÓ esta variável — nenhum código de aplicação muda.
IDENTITY_PROVIDER="demo"

# DEMO_MODE=true faz a API devolver o código OTP na própria resposta (sem SMS),
# para testar sem AWS. NUNCA use em produção: a aplicação RECUSA subir se
# DEMO_MODE=true e NODE_ENV=production ao mesmo tempo.
DEMO_MODE="true"

# Minutos de validade do código OTP no provider demo.
DEMO_OTP_TTL_MINUTOS="5"

# ─────────────────────────────────────────────────────────────────────────────
# AWS Cognito — PREENCHER quando o User Pool estiver pronto (IDENTITY_PROVIDER=cognito)
# Fluxo: Custom Auth Challenge (CUSTOM_AUTH) com Lambda triggers — ver
# infra/cognito-triggers/README.md para publicar os triggers na conta AWS.
# ─────────────────────────────────────────────────────────────────────────────
# Região AWS do User Pool (ex.: us-east-1).
COGNITO_REGION=""
# ID do User Pool (ex.: us-east-1_ABC123DEF).
COGNITO_USER_POOL_ID=""
# ID do App Client SEM client secret (fluxo público, chamado pelo backend).
# Precisa ter ALLOW_CUSTOM_AUTH habilitado nos Auth Flows do App Client.
COGNITO_CLIENT_ID=""
# Minutos que o código dura do lado do usuário (só exibição na UI). Default 3.
COGNITO_OTP_TTL_MINUTOS="3"
# Credenciais AWS: use a cadeia padrão do SDK. Em produção, prefira IAM Role
# (instance profile / IRSA), sem chaves no .env. Em dev, opcionalmente:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
#
# A IAM Role/usuário do backend precisa de: cognito-idp:AdminCreateUser,
# cognito-idp:AdminSetUserPassword, cognito-idp:InitiateAuth,
# cognito-idp:RespondToAuthChallenge (escopadas ao User Pool acima).
