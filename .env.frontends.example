# Usado só por scripts/deploy-frontends.sh — publica admin/booking/account
# em S3+CloudFront. Copie pra .env.frontends (não commitado) e preencha com
# os valores reais depois de criar os buckets/distribuições (ver AWS_SETUP.md).

# Embutidas no JS no BUILD (Vite) — mudar aqui exige rodar o script de novo.
VITE_COMPANY_ID="bigods"
VITE_BOOKING_URL="https://agendar.suabarbearia.com"
VITE_API_URL="https://api.suabarbearia.com"

# EXPERIMENTO (só o booking) — quem verifica o telefone no funil:
#   "api"     (default, produção) → a nossa API orquestra o OTP; código por WhatsApp.
#   "cognito"                     → o navegador autentica direto no Cognito via
#                                   Amplify (CUSTOM_AUTH); o código continua
#                                   chegando por WhatsApp (trigger da Lambda), e
#                                   a API só troca o idToken pela sessão.
# Com "cognito" as duas variáveis abaixo passam a ser OBRIGATÓRIAS — o front
# falha alto se faltarem, em vez de cair calado no caminho "api". O bundle do
# Amplify é carregado sob demanda, então deixar em "api" não custa nada.
# Exige também COGNITO_USER_POOL_ID/COGNITO_CLIENT_ID na API (ver .env.example).
VITE_AUTH_ADAPTER="api"
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_CLIENT_ID=""

# Um bucket S3 + uma distribuição CloudFront por app (ver AWS_SETUP.md §6).
ADMIN_S3_BUCKET=""
ADMIN_CLOUDFRONT_ID=""

BOOKING_S3_BUCKET=""
BOOKING_CLOUDFRONT_ID=""

ACCOUNT_S3_BUCKET=""
ACCOUNT_CLOUDFRONT_ID=""
