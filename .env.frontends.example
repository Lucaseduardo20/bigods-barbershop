# Usado só por scripts/deploy-frontends.sh — publica admin/booking/account
# em S3+CloudFront. Copie pra .env.frontends (não commitado) e preencha com
# os valores reais depois de criar os buckets/distribuições (ver AWS_SETUP.md).

# Embutidas no JS no BUILD (Vite) — mudar aqui exige rodar o script de novo.
VITE_COMPANY_ID="bigods"
VITE_BOOKING_URL="https://agendamento.bigodsbarbershop.com"
VITE_API_URL="https://api.bigodsbarbershop.com"

# Um bucket S3 + uma distribuição CloudFront por app (ver AWS_SETUP.md §6).
ADMIN_S3_BUCKET="bigods-admin-latest"
ADMIN_CLOUDFRONT_ID="E3B0X9SLAQ7027"

BOOKING_S3_BUCKET="bigods-booking-latest"
BOOKING_CLOUDFRONT_ID="EV4I2KOMPX2IQ"

ACCOUNT_S3_BUCKET="bigods-account-latest"
ACCOUNT_CLOUDFRONT_ID="E17JEXVUQPN6TW"
