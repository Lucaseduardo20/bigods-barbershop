{
  "name": "@bigods/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "seed:dev": "tsx ../../prisma/seed.ts",
    "seed:prod": "tsx src/scripts/seed-producao.ts",
    "test:watch": "vitest",
    "test:multitz": "for tz in UTC America/Sao_Paulo Asia/Tokyo; do echo \"== TZ=$tz ==\" && TZ=$tz vitest run || exit 1; done"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1087.0",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@bigods/contracts": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nestjs": "^10.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@bigods/config": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.43",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.0"
  }
}
