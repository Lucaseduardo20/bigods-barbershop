generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  BARBEIRO
}

enum StatusAtendimento {
  RESERVADO
  AGENDADO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
  RESERVA_EXPIRADA
}

enum OrigemAtendimento {
  AVULSO
  CREDITO_PACOTE
}

enum StatusItemPacote {
  DISPONIVEL
  AGENDADO
  CONSUMIDO
  SEGUNDA_CHANCE
  EXPIRADO
}

enum StatusPagamento {
  AGUARDANDO
  PAGO
  EXPIRADO
  FALHOU
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  PIX_ONLINE
  SALDO_RESIDUAL
}

enum ReferenciaPagamento {
  ATENDIMENTO
  VENDA_DE_PACOTE
}

enum OrigemDisponibilidade {
  EXPEDIENTE
  MANUAL
}

enum OrigemComissao {
  SERVICO
  PRODUTO
}

// Workflow de aprovação de PacoteOferta (sessão-B, Fase 3).
enum StatusAprovacaoPacoteOferta {
  RASCUNHO
  PENDENTE_APROVACAO
  APROVADO
  REJEITADO
}

model Company {
  id                     String @id
  nome                   String
  // ParametrosDaEmpresa: prazo da segunda chance (§4.2), ajustável pelo admin
  prazoReagendamentoDias Int    @default(10)
  // ParametrosDaEmpresa (sessão-E, §8.6): até quantas horas antes do horário
  // marcado o CLIENTE pode cancelar sozinho pelo cockpit — depois disso, o
  // app recusa e orienta a falar por WhatsApp. Ajustável pelo admin.
  janelaCancelamentoHoras Int  @default(2)
  // ParametrosDaEmpresa (sessão-E, §8.6): até quantas horas antes o CLIENTE
  // pode reagendar sozinho pelo cockpit (mover pra outra data/hora,
  // preservando serviço/barbeiro/crédito). Ajustável pelo admin.
  janelaReagendamentoHoras Int @default(12)
  // Fuso IANA da empresa (ex: "America/Sao_Paulo"). Propriedade da Company,
  // não constante global — outras barbearias em outros fusos usarão o sistema.
  // Validado como IANA válido na borda (VO Timezone), não por constraint de banco.
  timezone               String @default("America/Sao_Paulo")
  // Desconto progressivo dos avulsos (substituiu os combos fixos): teto do
  // desconto acumulado, por mais serviços que o cliente some. null = sem teto.
  // Os degraus por posição ficam em DegrauDeDesconto.
  descontoTetoCentavos   Int?

  servicos      Servico[]
  produtos      Produto[]
  degrausDesconto DegrauDeDesconto[]
  barbeiros     Barbeiro[]
  clientes      Cliente[]
  atendimentos  Atendimento[]
  vendasPacote  VendaDePacote[]
  vendasProduto VendaDeProduto[]
  lancamentos   LancamentoComissao[]
  intencoes     IntencaoDePagamento[]
  pacoteOfertas PacoteOferta[]
  vales         Vale[]
}

/**
 * Um degrau da tabela de desconto progressivo: "o serviço na POSIÇÃO N do
 * carrinho abate `valorCentavos`". Posição 1 nunca tem degrau (o primeiro
 * serviço é sempre preço cheio). Tabela GLOBAL da empresa — a mesma para todos
 * os barbeiros —, mas o desconto incide sobre o preço DAQUELE barbeiro.
 */
model DegrauDeDesconto {
  id            String @id
  companyId     String
  posicao       Int
  valorCentavos Int

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, posicao])
}

/**
 * "Cliente da casa" — relação BARBEIRO ↔ CLIENTE, nunca um flag global no
 * cliente. O mesmo cliente pode ser da casa do Gabriel e não ser do Lucas: a
 * marca vale só na agenda de quem marcou, porque é uma relação de confiança
 * pessoal, não um atributo do cliente.
 *
 * Chave composta = a própria relação. Não há status nem soft-delete: ou existe
 * a linha (é da casa) ou não existe (não é).
 */
model ClienteDaCasa {
  barbeiroId String
  clienteId  String
  marcadoEm  DateTime @default(now())

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])

  @@id([barbeiroId, clienteId])
  @@index([clienteId])
}

model Servico {
  id                  String  @id
  companyId           String
  nome                String
  precoAvulsoCentavos Int
  duracaoMinutos      Int
  ativo               Boolean @default(true)
  // Order-bump (sessão 2026-08-17): "este serviço aparece como sugestão de
  // complemento na confirmação do funil". Lista curada pelo admin — sem
  // segmentação por serviço/barbeiro, sem motor de regras condicionais
  // (decisão consciente, ver DECISOES_PENDENTES). Default false: serviço novo
  // não vira sugestão sozinho.
  sugeridoNoBump      Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// Produto (raiz) — venda de produto MÍNIMA, SEM controle de estoque (decisão
// consciente: sem quantidade/fornecedor). Soft-disable como Servico.
model Produto {
  id             String  @id
  companyId      String
  nome           String
  precoCentavos  Int
  ativo          Boolean @default(true)
  // Order-bump (sessão 2026-08-17) — mesmo mecanismo do Servico acima: só um
  // "aparece como sugestão: sim/não", curado pelo admin.
  sugeridoNoBump Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// PacoteOferta (raiz, agregado de domínio — sessão "sessão-B"): catálogo de
// pacotes que a barbearia oferece, com dono (barbeiroId) e composição mista
// (N serviços distintos, cada um com sua quantidade). O que se PERSISTE é
// sempre o preço em centavos — percentual de desconto é sempre DERIVADO na
// exibição, nunca fonte de verdade (mesma disciplina de snapshot do resto do
// sistema: dinheiro é congelado, o resto é recalculado). A venda em si
// continua passando por VendaDePacote/rateio (§3.6) — este agregado só
// define O QUE está à venda e por quanto, não o rateio.
model PacoteOferta {
  id             String                      @id
  companyId      String
  barbeiroId     String
  nome           String
  precoCentavos  Int
  ativo          Boolean                     @default(true)
  // Workflow de aprovação (Fase 3): só APROVADO aparece no funil público.
  // Default APROVADO — ofertas semeadas antes desta sessão continuam visíveis.
  statusAprovacao StatusAprovacaoPacoteOferta @default(APROVADO)
  motivoRejeicao  String?

  company  Company            @relation(fields: [companyId], references: [id])
  barbeiro Barbeiro           @relation(fields: [barbeiroId], references: [id])
  itens    PacoteOfertaItem[]

  @@index([companyId])
  @@index([barbeiroId])
}

// Composição da oferta: quais serviços (e em que quantidade) o pacote inclui.
// Suporta pacote MISTO (ex.: 2 cortes + 2 barbas no mesmo pacote).
model PacoteOfertaItem {
  id         String @id @default(uuid())
  ofertaId   String
  servicoId  String
  quantidade Int

  oferta PacoteOferta @relation(fields: [ofertaId], references: [id])

  @@index([ofertaId])
}

model Barbeiro {
  id                 String  @id
  companyId          String
  nome               String
  papeis             Papel[]
  comissaoPadraoBp   Int
  // Percentual ÚNICO para TODOS os produtos (sem matriz por produto — produto
  // é revenda, não tem a variação de margem de mão de obra que justifica a
  // matriz de serviços). Default 0%.
  comissaoProdutosBp Int     @default(0)
  ativo              Boolean @default(true)
  // Slug legível pra link pessoal de marketing (Fase 4b) — "/?barbeiro=gabriel"
  // em vez de UUID. Único por empresa, gerado no cadastro, editável pelo admin.
  slug               String

  // credenciais da autenticação local (infra — não fazem parte do domínio)
  login     String? @unique
  senhaHash String?

  company           Company            @relation(fields: [companyId], references: [id])
  excecoesComissao  ExcecaoComissao[]
  excecoesPreco     ExcecaoPreco[]
  servicosAtendidos BarbeiroServico[]
  disponibilidades  Disponibilidade[]
  expedienteJanelas ExpedienteJanela[]
  pacoteOfertas     PacoteOferta[]
  vendasDePacote    VendaDePacote[]
  clientesDaCasa    ClienteDaCasa[]

  @@unique([companyId, slug])
  @@index([companyId])
}

// Expediente semanal recorrente: para cada dia da semana, zero ou mais
// janelas de horário LOCAL. É o GERADOR das Disponibilidade dos próximos
// dias (materialização, via job + imediata ao salvar) — a disponibilidade
// por dia continua existindo e editável individualmente (folga, feriado); a
// edição manual de um dia não é sobrescrita pela materialização seguinte.
model ExpedienteJanela {
  id         String @id @default(uuid())
  barbeiroId String
  // 0=domingo .. 6=sábado — mesma convenção de Date.getUTCDay() sobre a data civil.
  diaSemana  Int
  horaInicio String // "HH:mm" local
  horaFim    String // "HH:mm" local

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@index([barbeiroId, diaSemana])
}

model ExcecaoComissao {
  barbeiroId   String
  servicoId    String
  percentualBp Int

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@id([barbeiroId, servicoId])
}

// Preço por barbeiro (sessão-B, Fase 2) — MESMO padrão de ExcecaoComissao:
// override por (barbeiro, serviço); ausência = usa Servico.precoAvulso (a
// referência da casa). `precoPara(servicoId, barbeiroId)` no domínio.
model ExcecaoPreco {
  barbeiroId    String
  servicoId     String
  precoCentavos Int

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@id([barbeiroId, servicoId])
}

model BarbeiroServico {
  barbeiroId String
  servicoId  String

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@id([barbeiroId, servicoId])
}

model Disponibilidade {
  id         String                @id
  barbeiroId String
  // Dia civil LOCAL (YYYY-MM-DD) a que esta janela pertence — "terça 9h–18h" no
  // horário do barbeiro. inicio/fim são os instantes UTC correspondentes.
  data       String
  inicio     DateTime              @db.Timestamptz(3)
  fim        DateTime              @db.Timestamptz(3)
  // EXPEDIENTE (gerada pela materialização) ou MANUAL (criada/editada à mão
  // pelo admin — a materialização NUNCA sobrescreve um dia com origem MANUAL).
  // Default MANUAL: linhas existentes antes desta coluna são tratadas como
  // edição manual, preservando o comportamento atual sem retrofit.
  origem     OrigemDisponibilidade @default(MANUAL)

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id])

  @@index([barbeiroId, data])
}

model Cliente {
  id         String  @id
  companyId  String
  nome       String
  telefone   String
  cognitoSub String?
  // Opcionais, coletados no funil (nunca obrigatórios — atrito no funil custa
  // conversão). Só são gravados quando o cliente preenche; um agendamento
  // posterior com o campo em branco NÃO apaga o que já havia.
  email      String?
  // "Fale sobre você": estilo de corte, se gosta de conversar, etc. É
  // informação para o BARBEIRO usar no atendimento — aparece no detalhe do
  // atendimento no painel.
  sobreVoce  String?

  company Company @relation(fields: [companyId], references: [id])
  daCasaDe ClienteDaCasa[]

  @@unique([companyId, telefone])
}

model Atendimento {
  id                 String            @id
  companyId          String
  clienteId          String
  barbeiroId         String
  inicio             DateTime          @db.Timestamptz(3)
  fim                DateTime          @db.Timestamptz(3)
  status             StatusAtendimento
  origem             OrigemAtendimento
  formaPagamento     FormaPagamento?
  motivoCancelamento String?
  // Fase 4c: registro de que o agendamento veio do link pessoal de um
  // barbeiro (marketing individual) — barbeiroId de quem divulgou, ou null se
  // veio do funil genérico. SÓ registro nesta sessão, sem tela de relatório.
  origemLinkBarbeiroId String?
  // FASE 4a (sessão-E, §8.7): quanto do total deste atendimento foi abatido
  // com saldo residual de um pacote (0 = nenhum abatimento). `vendaAbatidaId`
  // aponta pra QUAL pacote — auditoria (§ regra "não é coluna de saldo
  // mutável sem lastro": aqui é rastro de UM atendimento específico, não um
  // acumulador solto).
  valorAbatidoSaldoCentavos Int    @default(0)
  vendaAbatidaId            String?
  // Sessão de OTP+reserva: prazo da reserva TEMPORÁRIA (status RESERVADO,
  // canal online) — depois de confirmada (RESERVADO→AGENDADO) o campo
  // permanece preenchido como marca permanente de "veio do canal online"
  // (usado pela cota de presenciais pra excluir corretamente atendimentos
  // online da contagem). Null em qualquer atendimento presencial.
  reservaOnlineExpiraEm DateTime? @db.Timestamptz(3)

  company  Company               @relation(fields: [companyId], references: [id])
  itens    ItemAtendido[]
  produtos ItemProdutoAtendido[]

  @@index([barbeiroId, inicio])
  @@index([companyId, inicio])
  @@index([clienteId])
}

model ItemAtendido {
  id                   String  @id @default(uuid())
  atendimentoId        String
  servicoId            String
  valorCobradoCentavos Int
  duracaoMinutos       Int
  itemDoPacoteId       String?

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])

  @@index([atendimentoId])
}

// Produto vendido junto de um Atendimento (walk-in add-on na conclusão, item
// 4a) — distinto de VendaDeProduto (venda avulsa sem atendimento, item 4b).
// valorUnitarioCentavos é snapshot do preço vigente no momento da venda.
model ItemProdutoAtendido {
  id                    String @id @default(uuid())
  atendimentoId         String
  produtoId             String
  quantidade            Int    @default(1)
  valorUnitarioCentavos Int

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])

  @@index([atendimentoId])
}

model VendaDePacote {
  id                    String          @id
  companyId             String
  clienteId             String
  // Dono do pacote (sessão-B, Fase 2) — o rateio (§3.6) usa o preço DESTE
  // barbeiro no momento da venda; crédito só é consumido com ele (§8.2).
  barbeiroId            String
  valorPagoCentavos     Int
  saldoResidualCentavos Int             @default(0)
  // FASE 4a (sessão-E, §8.7): quanto do saldo residual já foi GASTO
  // (abatido em algum avulso) historicamente — só cresce. Existe pra manter
  // a invariante de conservação de dinheiro auditável mesmo depois que o
  // saldo é usado: Σvalorrateado(ativos) + saldoResidual + saldoUtilizado
  // == valorPago, sempre.
  saldoUtilizadoCentavos Int            @default(0)
  // FASE 4b (sessão-E, §8.7): saldo RESERVADO pra uma SolicitacaoDeReembolso
  // PENDENTE — sai de saldoResidual assim que a solicitação é criada (não
  // espera o admin confirmar), exatamente pra impedir abater (FASE 4a) e
  // reembolsar (FASE 4b) o MESMO dinheiro ao mesmo tempo: o abatimento só
  // enxerga `saldoResidual`, então dinheiro reservado já está fora do
  // alcance dele estruturalmente, não por uma checagem solta.
  saldoReservadoReembolsoCentavos Int   @default(0)
  // Saldo efetivamente devolvido (reembolso CONFIRMADO pelo admin) — só cresce.
  saldoReembolsadoCentavos Int          @default(0)
  // Instante da expiração mais recente que alimentou saldoResidual — âncora
  // do prazo de 45 dias pra pedir reembolso (§8.7). Null enquanto nunca
  // houve expiração nesta venda.
  saldoResidualDesde    DateTime?       @db.Timestamptz(3)
  compradoEm            DateTime        @db.Timestamptz(3)
  statusPagamento       StatusPagamento
  // Fase 4c: registro do link pessoal de barbeiro que originou a compra — só
  // registro, sem tela de relatório nesta sessão.
  origemLinkBarbeiroId  String?

  company              Company                  @relation(fields: [companyId], references: [id])
  barbeiro             Barbeiro                 @relation(fields: [barbeiroId], references: [id])
  itens                ItemDoPacote[]
  solicitacoesReembolso SolicitacaoDeReembolso[]

  @@index([clienteId])
  @@index([companyId])
  @@index([barbeiroId])
}

// FASE 4b (sessão-E, §8.7): pedido de reembolso do saldo residual — MANUAL
// (o dono confirmou: sem integração com gateway, sem estorno automático). O
// admin devolve o dinheiro por fora (PIX manual) e marca aqui quando feito.
enum StatusSolicitacaoReembolso {
  PENDENTE
  REEMBOLSADO
}

model SolicitacaoDeReembolso {
  id              String                     @id
  companyId       String
  vendaDePacoteId String
  clienteId       String
  valorCentavos   Int
  criadaEm        DateTime                   @db.Timestamptz(3)
  // Prazo pra pedir: 45 dias civis a contar de `VendaDePacote.saldoResidualDesde`.
  // Congelado na criação — nunca recalculado depois.
  prazoLimiteEm   DateTime                   @db.Timestamptz(3)
  status          StatusSolicitacaoReembolso
  reembolsadaEm   DateTime?                  @db.Timestamptz(3)

  venda VendaDePacote @relation(fields: [vendaDePacoteId], references: [id])

  @@index([companyId, status])
  @@index([vendaDePacoteId])
  @@index([clienteId])
}

model ItemDoPacote {
  id                    String           @id
  vendaId               String
  servicoId             String
  valorRateadoCentavos  Int
  status                StatusItemPacote
  faltasComputadas      Int              @default(0)
  // Fim do dia civil local (§4.2) — já um instante absoluto correto; o job de
  // expiração compara em UTC puro, sem precisar reconhecer o fuso de novo.
  prazoReagendamentoAte DateTime?        @db.Timestamptz(3)
  atendimentoId         String?

  venda VendaDePacote @relation(fields: [vendaId], references: [id])

  @@index([vendaId])
  @@index([status, prazoReagendamentoAte])
}

// Venda AVULSA de produto (item 4b — "alguém entrou só pra comprar", sem
// Atendimento associado). Registro simples: itens, quem vendeu, forma de
// pagamento, cliente opcional. Distinta do add-on em ItemProdutoAtendido
// (item 4a, vendido JUNTO de um atendimento).
model VendaDeProduto {
  id             String         @id
  companyId      String
  barbeiroId     String
  clienteId      String?
  formaPagamento FormaPagamento
  vendidoEm      DateTime       @db.Timestamptz(3)

  company Company              @relation(fields: [companyId], references: [id])
  itens   ItemVendaDeProduto[]

  @@index([companyId])
  @@index([barbeiroId])
}

model ItemVendaDeProduto {
  id                    String @id @default(uuid())
  vendaId               String
  produtoId             String
  quantidade            Int
  valorUnitarioCentavos Int

  venda VendaDeProduto @relation(fields: [vendaId], references: [id])

  @@index([vendaId])
}

// Ledger de 3 direções (sessão de vale/pagamento): `tipo` é o eixo NOVO —
// COMISSAO (+, já existia) | VALE (−) | PAGAMENTO (−). `origem` continua
// SERVICO|PRODUTO mas só faz sentido quando tipo=COMISSAO (por isso virou
// opcional aqui) — é um eixo DIFERENTE (o que gerou a comissão), não o mesmo
// campo generalizado de novo: colocar VALE/PAGAMENTO dentro de `origem`
// misturaria "sub-tipo de comissão" com "natureza do lançamento" no mesmo
// enum. valorBaseCentavos/percentualAplicadoBp só existem pra COMISSAO (vale
// e pagamento são valor direto, sem base×percentual) — por isso também
// nullable agora. Lançamentos existentes (todos tipo=COMISSAO, default) NÃO
// mudam de forma nem de valor — mesma disciplina da generalização anterior
// de origem (SERVICO→SERVICO|PRODUTO, sessão 2026-07-16).
model LancamentoComissao {
  id                    String          @id
  companyId             String
  barbeiroId            String
  tipo                  TipoLancamento  @default(COMISSAO)
  // Mantém o default histórico (SERVICO): código que cria um lançamento sem
  // passar `origem` explicitamente (não deveria acontecer, mas é a mesma
  // rede de segurança que já existia antes desta sessão) continua caindo em
  // SERVICO, nunca NULL por omissão. VALE/PAGAMENTO passam null EXPLICITAMENTE
  // (ver `LancamentoComissao.criarDeVale/criarDePagamento`) — um valor
  // explícito sempre vence o default do banco, então isso não conflita.
  origem                OrigemComissao? @default(SERVICO)
  atendimentoId         String?
  vendaDeProdutoId      String?
  servicoId             String?
  produtoId             String?
  // Preenchido só quando tipo=VALE — rastreia até o Vale (PAGO) que gerou
  // este débito. Sem @relation formal (mesmo padrão de atendimentoId acima:
  // referência de auditoria, não FK rígida).
  valeId                String?
  // Quem confirmou que o dinheiro se moveu de fato — o admin que marcou o
  // vale como PAGO, ou que registrou o pagamento (FASE 2). Null quando
  // tipo=COMISSAO (gerado pelo sistema, não por uma ação humana pontual).
  registradoPorId       String?
  valorBaseCentavos     Int?
  percentualAplicadoBp  Int?
  valorComissaoCentavos Int
  ocorridoEm            DateTime        @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@index([barbeiroId])
  @@index([atendimentoId])
  @@index([valeId])
}

// Vale/adiantamento de comissão (sessão de vale/pagamento) — item antes fora
// de escopo (DOMAIN.md §11), incluído agora por necessidade real da operação.
// Máquina de estado: PENDENTE → APROVADO → PAGO (só aqui nasce o débito no
// ledger, ver LancamentoComissao) | PENDENTE → NEGADO (final, motivo
// obrigatório). Um vale aprovado mas não pago é compromisso, não dinheiro
// movido — por isso o ledger só é afetado na transição APROVADO→PAGO.
enum TipoLancamento {
  COMISSAO
  VALE
  PAGAMENTO
}

enum StatusVale {
  PENDENTE
  APROVADO
  PAGO
  NEGADO
}

model Vale {
  id            String     @id
  companyId     String
  barbeiroId    String
  valorCentavos Int
  motivo        String?
  status        StatusVale @default(PENDENTE)
  solicitadoEm  DateTime   @db.Timestamptz(3)
  // PENDENTE → APROVADO ou PENDENTE → NEGADO
  decididoPorId String?
  decididoEm    DateTime?  @db.Timestamptz(3)
  motivoNegacao String?
  // APROVADO → PAGO (nasce o LancamentoComissao tipo=VALE nesta transição)
  pagoPorId     String?
  pagoEm        DateTime?  @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([barbeiroId])
}

model IntencaoDePagamento {
  id              String              @id
  companyId       String
  referenciaTipo  ReferenciaPagamento
  atendimentoId   String?
  vendaDePacoteId String?
  valorCentavos   Int
  status          StatusPagamento
  externalId      String              @unique
  // Sessão de pagamento online: prazo local do PIX (mesma janela pedida ao
  // gateway via `expiresIn`) — a AbacatePay não emite webhook de "expirou sem
  // pagar", só de disputa perdida (§3.8), então a expiração é detectada por
  // timeout contra este campo, não por evento externo. Null quando não é
  // pagamento online (presencial) ou em linhas anteriores a esta sessão.
  expiraEm        DateTime?           @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
}

// ── Identidade do cliente (provider demo) ─────────────────────────────────
// "User pool" do DemoIdentityProvider — o equivalente local ao Cognito, sem
// AWS. Só é usado quando IDENTITY_PROVIDER=demo. Em produção com Cognito estas
// tabelas ficam vazias (o pool vive na AWS).

/**
 * Usuário demo provisionado (um por telefone). `sub` é estável e vira Cliente.cognitoSub.
 */
model DemoIdentidade {
  id        String   @id @default(uuid())
  companyId String
  telefone  String // E.164
  sub       String   @unique
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([companyId, telefone])
}

/**
 * Desafio OTP demo: código de 6 dígitos (guardado com hash), com expiração e tentativas.
 */
model DemoDesafioLogin {
  id          String    @id @default(uuid())
  companyId   String
  telefone    String // E.164
  codigoHash  String // HMAC do código — nunca em claro
  expiraEm    DateTime  @db.Timestamptz(3)
  consumidoEm DateTime? @db.Timestamptz(3)
  tentativas  Int       @default(0)
  criadoEm    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([companyId, telefone])
}
