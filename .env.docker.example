# Template de .env para STAGING via Docker (docker-compose.staging.yml) — o
# rehearsal autocontido, roda em qualquer máquina, sem AWS. Pra produção real
# na AWS, use .env.aws.example (docker-compose.aws.yml) — topologia diferente
# (banco é RDS, frontends são S3+CloudFront). Difere do .env.example (dev
# local, sem Docker) principalmente nos HOSTNAMES: dentro do docker-compose,
# cada serviço enxerga os outros pelo NOME DO SERVIÇO ("postgres",
# "whatsapp-otp"), nunca "localhost" — "localhost" de dentro de um container é
# o PRÓPRIO container, não a máquina host nem outro container.
#
# Uso: `scripts/deploy.sh staging` copia este arquivo pra `.env`
# automaticamente na primeira vez, se `.env` ainda não existir. Depois disso,
# edite o `.env` do host — este arquivo nunca é sobrescrito de novo.

NODE_ENV="production"

# Dentro do docker-compose, o Postgres é o serviço "postgres" (ver
# docker-compose.yml), nunca "localhost". Troque só usuário/senha/db se você
# mudou o docker-compose.yml — o host TEM que continuar "postgres".
DATABASE_URL="postgresql://bigods:bigods@postgres:5432/bigods"

# Gere um valor novo por ambiente: openssl rand -hex 32
AUTH_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Identidade do CLIENTE final (login OTP por telefone) — produção usa whatsapp,
# SEMPRE (a aplicação recusa subir com NODE_ENV=production e outro valor).
# ─────────────────────────────────────────────────────────────────────────────
IDENTITY_PROVIDER="whatsapp"
DEMO_MODE="false"

# Dentro do docker-compose, o serviço de WhatsApp é "whatsapp-otp" (não
# "localhost"). Gere o token com: openssl rand -hex 32 — e cole o MESMO valor
# nas duas variáveis WHATSAPP_OTP_INTERNAL_TOKEN abaixo (usadas pelos dois
# lados: API cliente e serviço servidor, é a MESMA env var por design, só
# citando aqui pra reforçar que tem que bater).
WHATSAPP_OTP_SERVICE_URL="http://whatsapp-otp:3100"
WHATSAPP_OTP_INTERNAL_TOKEN=""
WHATSAPP_OTP_TIMEOUT_MS="8000"
WHATSAPP_OTP_TTL_MINUTOS="5"

# ─────────────────────────────────────────────────────────────────────────────
# Pagamento — o lançamento decidido nesta sessão é PRESENCIAL-ONLY: mantenha
# "fake" até decidir ligar o PIX online de verdade (troca de uma variável só,
# sem mudar código — ver ABACATEPAY_* abaixo quando for a hora).
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY="fake"
ABACATEPAY_API_KEY=""
ABACATEPAY_WEBHOOK_SECRET=""
ABACATEPAY_BASE_URL="https://api.abacatepay.com/v1"
ABACATEPAY_EXPIRA_SEGUNDOS="3600"

# ─────────────────────────────────────────────────────────────────────────────
# Frontends (Vite embute isso no JS no momento do BUILD da imagem — mudar
# aqui exige rebuildar as imagens: `scripts/deploy.sh staging --build`).
# ─────────────────────────────────────────────────────────────────────────────
# Tenant (companyId) que booking/account vão usar.
VITE_COMPANY_ID="bigods"
# URL pública do funil de agendamento (booking) — usada por admin/account pra
# montar links. Deixe em branco em staging se ainda não tiver domínio.
VITE_BOOKING_URL=""
